rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and programme settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow query scraping of users

      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'email', 'currentWeek'])
        && request.resource.data.currentWeek is number;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.id == resource.data.id;

      allow delete: if isOwner(userId);

      // User's private workout sessions and checklist history
      match /workoutRecords/{recordId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(recordId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['id', 'userId', 'date', 'workoutId', 'dayName', 'completed'])
          && request.resource.data.completed is bool
          && request.resource.data.workoutId is string
          && request.resource.data.date is string;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(recordId)
          && request.resource.data.userId == resource.data.userId;

        allow delete: if isOwner(userId) && isValidId(recordId);
      }
    }
  }
}
